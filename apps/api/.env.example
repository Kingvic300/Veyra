# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://veyra:veyra@localhost:5432/veyra
# Leave empty to process chain jobs in-process (no Redis needed).
REDIS_URL=redis://localhost:6379
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# 32 random bytes, base64: openssl rand -base64 32
VEYRA_MASTER_KEY=
DASHBOARD_ORIGIN=http://localhost:3000
# Enable the in-memory simulated chain (development and demos only).
ENABLE_SIMULATED_CHAIN=true
# Starknet JSON-RPC endpoints. Unset networks are disabled.
STARKNET_RPC_SEPOLIA=https://api.zan.top/public/starknet-sepolia/rpc/v0_10
STARKNET_RPC_MAINNET=
STARKNET_RPC_DEVNET=http://127.0.0.1:5050/rpc
# Experimental STRK20 private execution mode.
ENABLE_STRK20=false
# Seconds between transaction status checks.
TX_POLL_INTERVAL_SECONDS=5
